# ── Cryptographic secrets (CHANGE THESE IN PRODUCTION) ────────────────────────
# AES-256 shared key (64 hex chars = 32 bytes). Generate with: python -c "import os; print(os.urandom(32).hex())"
RPC_AUTH_AES_KEY_HEX=fb28d431bde358571a1dcb7a364f0428f5fc57574f2f51e4fe2181d9044be439

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RPC_AUTH_SECRET_KEY=rpc_auth_super_secret_2024

# ── Database ──────────────────────────────────────────────────────────────────
RPC_AUTH_DB_PATH=users.db

# ── Service hostnames / ports ────────────────────────────────────────────────
RPC_AUTH_AUTH_HOST=localhost
RPC_AUTH_AUTH_PORT=8001
RPC_AUTH_RPC_HOST=localhost
RPC_AUTH_RPC_PORT=8002
RPC_AUTH_GATEWAY_HOST=localhost
RPC_AUTH_GATEWAY_PORT=8000

# ── Seed users (comma-separated user:password pairs) ─────────────────────────
RPC_AUTH_SEED_USERS=alice:secret123,bob:pass456,admin:admin789

# ── WiFi Hotspot ──────────────────────────────────────────────────────────────
# Works on Linux (nmcli) and Windows (netsh). Auto-detected.
RPC_AUTH_HOTSPOT_SSID=RPC-Auth-Hotspot
RPC_AUTH_HOTSPOT_PASSWORD=rpcauth2024
RPC_AUTH_HOTSPOT_IFACE=
RPC_AUTH_HOTSPOT_CON_NAME=rpc_auth_hotspot
# On Linux, tries running without sudo first, then retries with sudo if needed.
# Set to "false" if running as root or don't want sudo.
RPC_AUTH_HOTSPOT_USE_SUDO=true
RPC_AUTH_HOTSPOT_BAND=bg
RPC_AUTH_HOTSPOT_CHANNEL=0
RPC_AUTH_HOTSPOT_POLL_INTERVAL=3